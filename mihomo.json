/**
 * Sub-Store → mihomo 配置生成脚本（覆写模式，入口 main(config)）
 * 规则、分组、DNS 与 sing-box/box.json 保持一致
 *
 * 用法：
 * 1. Sub-Store 新建「mihomo 配置」类型文件，来源选订阅或组合订阅
 * 2. 处理里添加「脚本操作」，粘贴本脚本
 * 3. 下载该文件即得完整 config.yaml
 */

const OPTIONS = {
  // 节点名包含下列内容时剔除
  NODE_EXCLUDE: /(剩余流量|套餐|到期时间|到期|官网|网址|邀请|群组|客服|公告|说明|流量|过期)/i,
  // 是否开启 TUN（只用系统代理就设为 false）
  ENABLE_TUN: true,
  // 规则集加速前缀，不需要就设为 ''
  GH_PROXY: 'https://ghfast.top/',
};

// 地区匹配：中文用完整地名，英文缩写要求前后不是字母（避免 de/au/us 误中 Russia、Macau 等）
const W = code => `(?<![a-z])(?:${code})(?![a-z])`;
const REGION = {
  hk: new RegExp(`香港|港|🇭🇰|${W('hk')}|hong\\s?kong`, 'i'),
  tw: new RegExp(`台湾|台灣|台北|台中|新北|🇨🇳|🇹🇼|${W('tw')}|taiwan`, 'i'),
  jp: new RegExp(`日本|东京|東京|大阪|🇯🇵|${W('jp')}|japan|韩国|韓國|首尔|首爾|🇰🇷|${W('kr')}|korea`, 'i'),
  sg: new RegExp(`新加坡|狮城|🇸🇬|${W('sg')}|singapore`, 'i'),
  us: new RegExp(`美国|美國|洛杉矶|圣何塞|硅谷|纽约|西雅图|🇺🇸|${W('us')}|united\\s?states|america|德国|德國|法兰克福|🇩🇪|${W('de')}|germany|澳大利亚|澳洲|悉尼|🇦🇺|${W('au')}|australia|英国|英國|伦敦|🇬🇧|${W('uk|gb')}|united\\s?kingdom|britain`, 'i'),
};
const REGIONS = ['hk', 'tw', 'jp', 'sg', 'us'];

// 业务分组：[名称, 默认是否直连]
const SERVICE_GROUPS = [
  ['google', false], ['apple', true], ['telegram', false],
  ['youtube', false], ['openai', false],
  ['cn', true], ['final', false],
];

// 规则集：[名称, 类型, 路径]
const RULE_SETS = [
  ['apple_ip', 'ipcidr', 'geo-lite/geoip/apple'],
  ['apple_domain', 'domain', 'geo-lite/geosite/apple'],
  ['cn_ip', 'ipcidr', 'geo/geoip/cn'],
  ['cn_domain', 'domain', 'geo-lite/geosite/cn'],
  ['google_ip', 'ipcidr', 'geo-lite/geoip/google'],
  ['google_domain', 'domain', 'geo-lite/geosite/google'],
  ['openai_domain', 'domain', 'geo/geosite/openai'],
  ['proxy_domain', 'domain', 'geo/geosite/geolocation-!cn'],
  ['telegram_ip', 'ipcidr', 'geo-lite/geoip/telegram'],
  ['telegram_domain', 'domain', 'geo-lite/geosite/telegram'],
  ['youtube_domain', 'domain', 'geo-lite/geosite/youtube'],
];

const RULES = [
  'IP-CIDR,10.0.0.0/8,DIRECT,no-resolve',
  'IP-CIDR,172.16.0.0/12,DIRECT,no-resolve',
  'IP-CIDR,192.168.0.0/16,DIRECT,no-resolve',
  'IP-CIDR,127.0.0.0/8,DIRECT,no-resolve',
  'IP-CIDR6,fc00::/7,DIRECT,no-resolve',
  'RULE-SET,youtube_domain,youtube',
  'RULE-SET,openai_domain,openai',
  'AND,((RULE-SET,proxy_domain),(NOT,((OR,((RULE-SET,cn_domain),(RULE-SET,apple_domain),(RULE-SET,google_domain),(RULE-SET,telegram_domain)))))),proxy',
  'RULE-SET,telegram_domain,telegram',
  'RULE-SET,telegram_ip,telegram',
  'RULE-SET,google_domain,google',
  'RULE-SET,google_ip,google',
  'RULE-SET,apple_domain,apple',
  'RULE-SET,apple_ip,apple',
  'RULE-SET,cn_domain,cn',
  'RULE-SET,cn_ip,cn',
  'MATCH,final',
];

function cleanProxies(input) {
  const reserved = new Set(['DIRECT', 'REJECT', 'COMPATIBLE', 'GLOBAL', 'proxy', 'all', ...REGIONS, ...SERVICE_GROUPS.map(g => g[0])]);
  const used = new Set();
  const out = [];
  for (const item of Array.isArray(input) ? input : []) {
    if (!item || typeof item !== 'object') continue;
    let name = String(item.name ?? '').trim();
    if (!name || OPTIONS.NODE_EXCLUDE.test(name)) continue;
    // 台区国旗 🇹🇼 → 🇨🇳；修复国旗与名称之间丢失的空格
    name = name.replace(/🇹🇼/g, '🇨🇳').replace(/([\u{1F1E6}-\u{1F1FF}]{2})([^\s])/gu, '$1 $2');
    if (reserved.has(name)) name = `${name} · 节点`;
    let final = name, i = 2;
    while (used.has(final)) final = `${name} ${i++}`;
    used.add(final);
    out.push({ ...item, name: final });
  }
  // 删除失效的 dialer-proxy 依赖
  out.forEach(p => { if (p['dialer-proxy'] && !used.has(p['dialer-proxy'])) delete p['dialer-proxy']; });
  return out;
}

function buildGroups(proxies) {
  const names = proxies.map(p => p.name);
  const regionMembers = Object.fromEntries(REGIONS.map(r => [r, names.filter(n => REGION[r].test(n))]));
  // 没有节点的地区组不生成，也不出现在其他组里
  const regions = REGIONS.filter(r => regionMembers[r].length);
  const pool = [...regions, 'all'];
  const groups = [
    { name: 'proxy', type: 'select', proxies: ['all', ...regions, 'DIRECT'] },
    ...SERVICE_GROUPS.map(([name, direct]) => ({
      name, type: 'select',
      proxies: direct ? ['DIRECT', 'proxy', ...pool] : ['proxy', 'DIRECT', ...pool],
    })),
    ...regions.map(r => ({ name: r, type: 'select', proxies: regionMembers[r] })),
    { name: 'all', type: 'select', proxies: names.length ? names : ['COMPATIBLE'] },
  ];
  return groups;
}

function buildRuleProviders() {
  const base = `${OPTIONS.GH_PROXY}https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta`;
  return Object.fromEntries(RULE_SETS.map(([name, behavior, path]) => [name, {
    type: 'http', behavior, format: 'mrs', interval: 86400,
    path: `./rules/${name}.mrs`, url: `${base}/${path}.mrs`,
  }]));
}

function main(input) {
  const config = input && typeof input === 'object' ? input : {};
  const proxies = cleanProxies(config.proxies);

  return {
    'mixed-port': 7890,
    'allow-lan': false,
    mode: 'rule',
    'log-level': 'info',
    ipv6: true,
    'unified-delay': true,
    'tcp-concurrent': true,
    'find-process-mode': 'strict',
    'external-controller': '127.0.0.1:9090',
    'external-ui': 'ui',
    'external-ui-url': `${OPTIONS.GH_PROXY}https://github.com/MetaCubeX/metacubexd/archive/refs/heads/gh-pages.zip`,
    profile: { 'store-selected': true, 'store-fake-ip': true },
    'geodata-mode': false,
    'geo-auto-update': false,
    sniffer: {
      enable: true,
      'parse-pure-ip': true,
      sniff: {
        HTTP: { ports: [80, '8080-8880'], 'override-destination': true },
        TLS: { ports: [443, 8443] },
        QUIC: { ports: [443, 8443] },
      },
    },
    tun: {
      enable: OPTIONS.ENABLE_TUN,
      stack: 'mixed',
      'auto-route': true,
      'auto-redirect': true,
      'auto-detect-interface': true,
      'strict-route': true,
      'dns-hijack': ['any:53', 'tcp://any:53'],
    },
    dns: {
      enable: true,
      listen: '0.0.0.0:1053',
      ipv6: true,
      'enhanced-mode': 'fake-ip',
      'fake-ip-range': '198.18.0.1/16',
      'fake-ip-filter-mode': 'blacklist',
      'fake-ip-filter': ['rule-set:cn_domain', '+.lan', '+.local'],
      'default-nameserver': ['223.5.5.5'],
      'proxy-server-nameserver': ['https://223.5.5.5/dns-query'],
      'direct-nameserver': ['https://223.5.5.5/dns-query'],
      'nameserver-policy': { 'rule-set:cn_domain': ['https://223.5.5.5/dns-query'] },
      nameserver: ['https://8.8.8.8/dns-query#proxy'],
    },
    proxies,
    'proxy-groups': buildGroups(proxies),
    'rule-providers': buildRuleProviders(),
    rules: RULES,
  };
}
