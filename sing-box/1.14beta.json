{
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": true
  },
  "http_clients": [
    {
      "tag": "my-client",
      "engine": "go"
    }
  ],
  "dns": {
    "servers": [
      {
        "tag": "local",
        "type": "https",
        "server": "223.5.5.5",
        "detour": "direct"
      },
      {
        "tag": "remote",
        "type": "https",
        "server": "8.8.8.8",
        "detour": "proxy"
      },
      {
        "tag": "fakeip",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      {
        "clash_mode": "Direct",
        "server": "local"
      },
      {
        "clash_mode": "Global",
        "server": "fakeip"
      }
    ],
    "final": "remote"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "stack": "mixed",
      "auto_route": true,
      "strict_route": true
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 7890
    }
  ],
  "route": {
    "default_domain_resolver": {
      "server": "local"
    },
    "default_http_client": "my-client",
    "auto_detect_interface": true,
    "rules": [
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct"
      },
      {
        "clash_mode": "Direct",
        "action": "route",
        "outbound": "direct"
      }
    ],
    "final": "final"
  },
  "outbounds": [
    {
      "type": "selector",
      "tag": "proxy",
      "outbounds": [
        "all-auto",
        "direct"
      ],
      "default": "all-auto"
    },
    {
      "type": "urltest",
      "tag": "all-auto",
      "outbounds": [],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "1m",
      "tolerance": 50
    },
    {
      "type": "selector",
      "tag": "final",
      "outbounds": [
        "proxy",
        "direct"
      ],
      "default": "proxy"
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "external_ui": "ui",
      "external_ui_download_url": "https://github.com/MetaCubeX/metacubexd/archive/refs/heads/gh-pages.zip"
    },
    "cache_file": {
      "enabled": true,
      "store_fakeip": true
    }
  }
}